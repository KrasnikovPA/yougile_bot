# Обязательные переменные
YOUGILE_TOKEN=ваш_токен_yougile
YOUGILE_BOARD=id_доски_yougile
TELEGRAM_TOKEN=токен_telegram_бота

# Опционально: ID колонки, в которую бот создаёт задачи и по которой фильтрует список задач
COLUMN_ID=

# Опционально: префикс коротких номерных ключей задач в Yougile (idTaskProject),
# например "ID" даёт ключи вида "ID-2990". Узнать свой префикс можно у любой задачи
# в интерфейсе Yougile — он указан рядом с названием задачи. По умолчанию "ID".
YOUGILE_KEY_PREFIX=ID

# Опционально: диапазон номеров, который сканируется за один проход scanNumericKeys/fullscan
YOUGILE_SCAN_RANGE=20

# Опционально: политика повторов запросов к Yougile API
YOUGILE_RETRY_COUNT=3
YOUGILE_RETRY_WAIT_MS=500
YOUGILE_MAX_RETRY_ELAPSED_SEC=10

# Опционально: подробное логирование запросов/ответов Yougile API (1/true, иначе выключено)
YOUGILE_VERBOSE_LOG=
